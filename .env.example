# Copy to .env and fill in values.

# Required. Voice access from https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Built-in voice or a custom voice id from the xAI custom voices API.
VOICE=eve
VOICE_MODEL=grok-voice-latest
# Used when a doorbell or describe_camera call looks at a snapshot.
XAI_VISION_MODEL=grok-4
# Optional BCP-47 hint, for example es-MX or ja.
# LANGUAGE_HINT=

# This satellite's room. "turn off the lights" targets lights whose names include it.
ROOM=living room

# Home Assistant. Leave the placeholders to run voice-only.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token
# Optional entity ids. Empty means "first matching entity".
# WEATHER_ENTITY=weather.home
# CALENDAR_ENTITY=calendar.personal
# MEDIA_ENTITY=media_player.living_room
# TODO_ENTITY=todo.shopping
# DOORBELL_CAMERA=camera.front_door
# Comma-separated entity ids to watch in addition to ALERT_MATCH.
# ALERT_ENTITIES=binary_sensor.basement_leak
# ALERT_MATCH=doorbell,leak,smoke,carbon_monoxide,moisture,water_leak
# CRITICAL_MATCH=smoke,carbon_monoxide,leak,moisture,gas
# DOORBELL_ENTITIES=binary_sensor.front_doorbell
ALERT_POLL_SECS=5

# Read-only MCP. Both the URL and an allowlist are required before the tool is registered.
# HA_MCP_URL=https://homeassistant.local/api/mcp
# HA_MCP_TOKEN=
# HA_MCP_ALLOWED_TOOLS=get_state,list_entities

# xAI collection of household notes. Enables file search in the voice session.
# COLLECTION_ID=

ENABLE_WEB_SEARCH=true
ENABLE_X_SEARCH=false

# energy keeps the socket closed until the room gets loud. always streams the whole session.
WAKE_MODE=energy
# Empty string disables the phrase check.
WAKE_PHRASE=hey grok
WAKE_RMS=0.05
WAKE_HOLD_MS=250
SILENCE_SECS=8
FOLLOW_UP_SECS=20
# Reconnect before the API's 120 minute cap. Resumption replays the conversation.
SESSION_ROTATE_MINS=110

# auto plays in the room that just spoke. local, satellite, or both.
AUDIO_OUTPUT=auto
# Fixed-delay echo subtract. Set ECHO_GAIN=0 if the mic sounds worse.
ECHO_DELAY_MS=80
ECHO_GAIN=0.3
BARGE_IN=true
BARGE_RMS=0.12

QUIET_HOURS=true
QUIET_START=22:00
QUIET_END=07:00
# Critical alerts still speak when nobody is marked home.
ANNOUNCE_WHEN_EMPTY=false

# Locks and alarm panels always confirm. Entity ids containing these do too.
CONFIRM_DOMAINS=lock,alarm_control_panel
CONFIRM_MATCH=garage_door,front_door,unlock,disarm

HEALTH_BIND=0.0.0.0
HEALTH_PORT=8080
# Leave empty to keep the status console open. At least 8 characters. A value containing your_ is ignored.
# DASHBOARD_PASSWORD=
SATELLITE_BIND=0.0.0.0
SATELLITE_PORT=8765

LOG_DIR=logs
DATA_DIR=data
ALIASES_FILE=aliases.json
RUST_LOG=info
